{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "qlik": {
      "command": "uvx",
      "args": [
        "qlik-sense-mcp-server==2.0.0",
        "--stdio"
      ],
      "env": {
        "QLIK_SERVER_URL": "${QLIK_SERVER_URL}",
        "QLIK_JWT_TOKEN": "${QLIK_JWT_TOKEN}"
      }
    }
  }
}
